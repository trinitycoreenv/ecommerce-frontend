# ============================================================================
# E-COMMERCE MULTI-VENDOR MARKETPLACE - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit .env file to version control
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# IMPORTANT: Special characters in password must be URL-encoded:
#   @ → %40
#   # → %23
#   $ → %24
#   % → %25
#   & → %26
#   + → %2B
#   / → %2F
#   : → %3A
#   ; → %3B
#   = → %3D
#   ? → %3F
#
# Examples:
#   Local: postgresql://postgres:mypassword@localhost:5432/ecommerce_db?schema=public
#   Remote: postgresql://user:pass%40word@db.example.com:5432/ecommerce_db?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ecommerce_db?schema=public"

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Secret key for signing JWT tokens - MUST be changed in production
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# JWT token expiration time (examples: 1h, 7d, 30d)
JWT_EXPIRES_IN="7d"

# ============================================================================
# NEXTAUTH CONFIGURATION
# ============================================================================
# Application URL - Update for production deployment
NEXTAUTH_URL="http://localhost:3000"

# NextAuth secret - Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"

# ============================================================================
# APPLICATION URLS
# ============================================================================
# Public-facing application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API URL for frontend to backend communication
# For same-device access: use "/api" (relative path)
# For network access (mobile, other devices): use "http://YOUR_IP:3000/api"
# Get your IP: ipconfig (Windows) or ifconfig (Mac/Linux)
NEXT_PUBLIC_API_URL="/api"

# Example for network access from other devices:
# NEXT_PUBLIC_APP_URL="http://192.168.1.100:3000"
# NEXT_PUBLIC_API_URL="http://192.168.1.100:3000/api"

# ============================================================================
# STRIPE PAYMENT INTEGRATION
# ============================================================================
# Get your Stripe API keys from: https://dashboard.stripe.com/test/apikeys
# For development: Use TEST keys (pk_test_... and sk_test_...)
# For production: Use LIVE keys (pk_live_... and sk_live_...)

# Stripe Secret Key (Backend) - NEVER expose this in frontend code
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"

# Stripe Publishable Key (Frontend) - Safe to expose in client-side code
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# Stripe Webhook Secret - Get from Stripe Dashboard or Stripe CLI
# Stripe CLI: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# ============================================================================
# SHIPPO SHIPPING INTEGRATION
# ============================================================================
# Get your Shippo API key from: https://apps.goshippo.com/settings/api
# For development: Use TEST/SANDBOX key (shippo_test_...)
# For production: Use LIVE key (shippo_live_...)

# Shippo API Key
SHIPPO_API_KEY="shippo_test_your_shippo_api_key_here"

# Shippo Webhook URL - For receiving tracking updates
# Development: Use ngrok to expose local server
#   1. Install ngrok: https://ngrok.com/download
#   2. Run: ngrok http 3000
#   3. Copy the HTTPS URL and append /api/webhooks/shipping
# Production: Use your actual domain
SHIPPO_WEBHOOK_URL="https://your-ngrok-url.ngrok-free.app/api/webhooks/shipping"

# Optional: Shippo webhook secret for verification
SHIPPO_WEBHOOK_SECRET="your-shippo-webhook-secret"

# ============================================================================
# EMAIL CONFIGURATION - SENDGRID (Recommended)
# ============================================================================
# Get your SendGrid API key from: https://app.sendgrid.com/settings/api_keys
# Free tier: 100 emails/day
# Sign up: https://signup.sendgrid.com/

# SendGrid API Key
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"

# Email sender information
FROM_EMAIL="noreply@yourdomain.com"
FROM_NAME="E-commerce Platform"

# ============================================================================
# ALTERNATIVE EMAIL CONFIGURATION - SMTP (Optional)
# ============================================================================
# If not using SendGrid, you can use any SMTP server
# Example: Gmail, Outlook, custom SMTP server

# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-specific-password"

# For Gmail:
#   1. Enable 2-factor authentication
#   2. Generate app password: https://myaccount.google.com/apppasswords
#   3. Use the generated password in SMTP_PASS

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE="10485760"

# Upload directory (relative to project root)
UPLOAD_DIR="./public/uploads"

# ============================================================================
# COMMISSION RATES
# ============================================================================
# Platform commission rates by subscription tier (as decimal, e.g., 0.1 = 10%)
DEFAULT_COMMISSION_RATE="0.15"      # 15% - Starter tier
BASIC_COMMISSION_RATE="0.12"        # 12% - Basic tier
PREMIUM_COMMISSION_RATE="0.08"      # 8% - Premium tier
ENTERPRISE_COMMISSION_RATE="0.05"   # 5% - Enterprise tier

# ============================================================================
# SUBSCRIPTION PRICING (in PHP/Pesos)
# ============================================================================
# Monthly subscription prices for each tier
STARTER_SUBSCRIPTION_PRICE="0"          # Free tier
BASIC_SUBSCRIPTION_PRICE="2000"         # ₱2,000/month
PREMIUM_SUBSCRIPTION_PRICE="5000"       # ₱5,000/month
ENTERPRISE_SUBSCRIPTION_PRICE="10000"   # ₱10,000/month

# ============================================================================
# CRON JOB AUTHENTICATION (Optional)
# ============================================================================
# Secret key for authenticating automated cron jobs
# Used for inventory monitoring, payout processing, etc.
# CRON_SECRET="your-cron-secret-key"

# ============================================================================
# DEVELOPMENT & DEBUGGING (Optional)
# ============================================================================
# Set to "development" or "production"
# NODE_ENV="development"

# Enable debug logging
# DEBUG="true"

# Prisma logging
# DATABASE_LOGGING="true"

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production, ensure you:
#
# ✓ Generate new secure secrets for JWT_SECRET and NEXTAUTH_SECRET
# ✓ Use Stripe LIVE keys (pk_live_... and sk_live_...)
# ✓ Use Shippo LIVE API key (shippo_live_...)
# ✓ Update all URLs to your production domain
# ✓ Set up Stripe webhooks with production URL
# ✓ Set up Shippo webhooks with production URL
# ✓ Use production SendGrid API key
# ✓ Update FROM_EMAIL to your actual domain email
# ✓ Set NODE_ENV="production"
# ✓ Never commit .env file to version control
# ✓ Use environment variables in your hosting platform
# ============================================================================
